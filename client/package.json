    "jest-styled-components": "7.2.0",
    "jsdom": "26.0.0",
    "lint-staged": "15.4.3",
    "prettier": "3.4.2",
    "resize-observer-polyfill": "1.5.1",
    "typescript": "5.7.3",
    "typescript-eslint": "8.23.0",
    "vite": "6.1.0",
    "vite-plugin-svgr": "4.3.0",
