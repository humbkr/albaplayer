{
  "name": "albaplayer",
  "private": true,
  "version": "3.0.0-rc6",
  "type": "module",
  "scripts": {
    "dev": "yarn install && vite",
    "start": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest watch",
    "test:nw": "vitest run",
    "test:c": "vitest run --coverage",
    "format": "prettier --write ./src",
    "lint": "yarn format --log-level silent && yarn eslint:fix && yarn type-check",
