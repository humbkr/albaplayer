  "private": true,
  "dependencies": {
    "@hello-pangea/dnd": "^16.2.0",
    "@hookform/resolvers": "3.10.0",
    "@reduxjs/toolkit": "2.5.0",
    "@rtk-query/graphql-request-base-query": "2.3.1",
    "dayjs": "1.11.13",
    "graphql": "16.10.0",
    "graphql-request": "6.1.0",
    "i18next": "24.2.1",
    "react": "^18.2.0",
    "react-contexify": "^4.1.1",
    "react-debounce-input": "^3.3.0",
    "react-dom": "^18.2.0",
    "react-hook-form": "7.54.2",
    "react-i18next": "15.4.0",
    "react-modal": "3.16.3",
    "react-redux": "9.2.0",
    "react-router": "7.1.2",
    "react-router-dom": "7.1.2",
    "react-slider": "2.0.6",
    "react-toastify": "11.0.3",
    "react-virtuoso": "4.12.3",
    "redux-persist": "^6.0.0",
    "reselect": "5.1.1",
    "styled-components": "6.1.14",
    "workbox-background-sync": "7.3.0",
    "workbox-broadcast-update": "7.3.0",
    "workbox-cacheable-response": "7.3.0",
    "workbox-core": "7.3.0",
    "workbox-expiration": "7.3.0",
    "workbox-google-analytics": "7.3.0",
    "workbox-navigation-preload": "7.3.0",
    "workbox-precaching": "7.3.0",
    "workbox-range-requests": "7.3.0",
    "workbox-routing": "7.3.0",
    "workbox-strategies": "7.3.0",
    "workbox-streams": "7.3.0",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@babel/runtime": "7.26.0",
    "@testing-library/dom": "10.4.0",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.2.0",
    "@testing-library/user-event": "14.6.0",
    "@types/jest": "29.5.14",
    "@types/node": "22.10.7",
    "@types/react": "^18.0.26",
    "@types/react-dom": "^18.0.10",
    "@types/react-modal": "^3.16.3",
    "@types/react-router-dom": "^5.1.3",
    "@types/react-slider": "1.3.6",
    "@types/styled-components": "5.1.34",
    "babel-plugin-styled-components": "2.1.4",
    "customize-cra": "^1.0.0",
    "eslint-config-prettier": "10.0.1",
    "jest-extended": "4.0.2",
    "jest-styled-components": "7.2.0",
    "lint-staged": "15.4.1",
    "prettier": "3.4.2",
    "react-app-rewired": "^2.2.1",
    "react-scripts": "5.0.1",
    "resize-observer-polyfill": "^1.5.1",
    "ts-jest": "29.2.5",
    "typescript": "5.7.3",
    "web-vitals": "4.2.4"
  },
  "scripts": {
    "dev": "yarn install && yarn start",
    "start": "react-app-rewired start",
    "build": "react-app-rewired build",
    "test": "react-app-rewired test",
    "test:coverage": "react-scripts test --coverage --watchAll=false",
    "eject": "react-scripts eject",
    "lint:prettier": "prettier --check './src/**/*.{js,jsx,ts,tsx}'",
    "lint:eslint": "eslint src/",
    "lint:tsc": "tsc --noEmit",
    "lint": "prettier --check './src/**/*.{js,jsx,ts,tsx}' && eslint src/ && tsc --noEmit",
    "lint:fix": "prettier --write './src/**/*.{js,jsx,ts,tsx}' && eslint src/ --fix && tsc --noEmit"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "jest": {
    "coveragePathIgnorePatterns": [
      "<rootDir>/__tests__/test-utils/"
    ],
    "collectCoverageFrom": [
      "src/**/*.{ts,tsx}"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 50,
        "functions": 50,
        "lines": 50,
        "statements": 50
      }
    },
    "transform": {
      "^.+\\.(js|jsx|ts|tsx)$": "<rootDir>/node_modules/ts-jest"
    }
  }
}
