    "@rtk-query/graphql-request-base-query": "2.3.1",
    "dayjs": "1.11.13",
    "graphql": "16.10.0",
    "graphql-request": "7.1.2",
    "i18next": "24.2.2",
    "react": "19.0.0",
    "react-contexify": "4.1.1",
    "react-debounce-input": "3.3.0",
    "react-dom": "19.0.0",
    "react-hook-form": "7.54.2",
    "react-i18next": "15.4.0",
    "react-modal": "3.16.3",
